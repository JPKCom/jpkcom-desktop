# JPKCom Desktop — npm settings for the development tools — © Jean Pierre Kolb — MIT License
#
# Block preinstall/install/postinstall/prepare scripts of packages: most npm supply-chain attacks run
# through install hooks. Neither @tabler/icons nor playwright-core needs one (the headless browser is
# downloaded on request: npm run browsers).
ignore-scripts=true

# Write exact versions on install (no ^ or ~ ranges in package.json): an update is a deliberate,
# reviewable change of package.json and package-lock.json.
save-exact=true

# Refuse to install on a Node.js version outside "engines" in package.json.
engine-strict=true
